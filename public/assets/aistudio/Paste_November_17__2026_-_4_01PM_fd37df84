            <div className="pt-4 mt-2 border-t border-[#D8D9D6] flex flex-col items-center gap-2 text-center">
              {user ? (
                <div className="text-xs text-[#5B6660]">
                  Signed in as <strong className="text-[#1A211D]">{user.email}</strong>
                </div>
              ) : (
                <>
                  <p className="text-xs text-[#5B6660] m-0">
                    Sign in with Google to sync submissions and save records to Google Drive.
                  </p>
                  <GoogleSignInButton
                    onClick={onGoogleSignIn}
                    disabled={isLoggingInGoogle}
                    label={isLoggingInGoogle ? 'Signing in…' : 'Sign in with Google'}
