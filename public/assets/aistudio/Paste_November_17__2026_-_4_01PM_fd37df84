  try {
    await setDoc(
      userRef,
      {
        id: user.uid,
        email: user.email.slice(0, 200),
        displayName: (user.displayName || user.email.split('@')[0] || 'User').slice(0, 150),
        updatedAt: serverTimestamp(),
      },
      { merge: true }
    );
  } catch (error) {
    // Non-blocking warning if profile write fails before rules settle
    console.warn('User profile sync skipped:', error);
  }
}

export function initAuthListener(
  onUpdate: (state: {
    user: User | null;
    accessToken: string | null;
    ready: boolean;
  }) => void
): () => void {
  return onAuthStateChanged(auth, (user) => {
    if (!user) {
      cachedAccessToken = null;
      onUpdate({ user: null, accessToken: null, ready: true });
      return;
    }
    if (!isSigningIn && !cachedAccessToken) {
      onUpdate({ user, accessToken: null, ready: true });
      return;
    }
    onUpdate({ user, accessToken: cachedAccessToken, ready: true });
  });
}

export async function googleSignIn(): Promise<{
  user: User;
  accessToken: string | null;
}> {
  isSigningIn = true;
  try {
    const result = await signInWithPopup(auth, googleProvider);
    const credential = GoogleAuthProvider.credentialFromResult(result);
    cachedAccessToken = credential?.accessToken ?? null;
    await syncUserProfile(result.user);
    return { user: result.user, accessToken: cachedAccessToken };
  } finally {
    isSigningIn = false;
  }
}

export async function logoutGoogle(): Promise<void> {
  cachedAccessToken = null;
  await signOut(auth);
}

export function getAccessToken(): string | null {
  return cachedAccessToken;
}

export interface DriveUploadResult {
  fileId: string;
  fileUrl: string;
  folderUrl: string;
}

export async function saveApplicationToDrive(
  accessToken: string,
  refNo: string,
  formData: ApplicationFormData,
  aiSummary: string
): Promise<DriveUploadResult> {
  // 1. Find or create the 'franchising' folder in Google Drive
  const query = encodeURIComponent(
    "name='franchising' and mimeType='application/vnd.google-apps.folder' and trashed=false"
  );
  const searchRes = await fetch(
    `https://www.googleapis.com/drive/v3/files?q=${query}&fields=files(id,name,webViewLink)`,
    {
      headers: { Authorization: `Bearer ${accessToken}` },
    }
  );

  if (searchRes.status === 401) {
    cachedAccessToken = null;
    throw new Error('Google Drive authorization expired. Please sign in with Google again.');
  }
  if (!searchRes.ok) {
    throw new Error(`Google Drive folder lookup failed (${searchRes.status}).`);
  }

  const searchJson = (await searchRes.json()) as {
    files?: Array<{ id: string; name: string; webViewLink?: string }>;
  };

  let folderId = searchJson.files?.[0]?.id;
  let folderUrl = searchJson.files?.[0]?.webViewLink || 'https://drive.google.com/drive/my-drive';

  if (!folderId) {
    const createFolderRes = await fetch(
      'https://www.googleapis.com/drive/v3/files?fields=id,webViewLink',
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name: 'franchising',
          mimeType: 'application/vnd.google-apps.folder',
        }),
      }
    );

    if (!createFolderRes.ok) {
      throw new Error(`Could not create "franchising" folder in Google Drive (${createFolderRes.status}).`);
    }

    const createdFolder = (await createFolderRes.json()) as {
      id: string;
      webViewLink?: string;
    };
    folderId = createdFolder.id;
    folderUrl = createdFolder.webViewLink || `https://drive.google.com/drive/folders/${folderId}`;
  }

  // 2. Upload application record inside the 'franchising' folder using multipart upload
  const safeApplicant = (formData.applicantName || 'Applicant').replace(/[^a-zA-Z0-9_-]/g, '_');
  const fileName = `${refNo}_${safeApplicant}.json`;

  const metadata = {
    name: fileName,
    mimeType: 'application/json',
    parents: [folderId],
    description: `Municipality of Sofronio Española Tricycle Franchise Application ${refNo}`,
  };

  const payload = JSON.stringify(
    {
      refNo,
      municipality: 'Municipality of Sofronio Española, Palawan',
      ordinance: 'Ordinance No. 2018-836',
      submittedAt: new Date().toISOString(),
      targetMailboxNote: 'sangguniangbayan01@gmail.com / franchising',
      automatedComplianceSummary: aiSummary,
      application: formData,
    },
    null,
    2
  );

  const boundary = 'sof_esp_drive_boundary_93847';
  const multipartBody =
    `--${boundary}\r\n` +
    'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
    `${JSON.stringify(metadata)}\r\n` +
    `--${boundary}\r\n` +
    'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
    `${payload}\r\n` +
    `--${boundary}--`;

  const uploadRes = await fetch(
    'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,webViewLink',
    {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${accessToken}`,
        'Content-Type': `multipart/related; boundary=${boundary}`,
      },
      body: multipartBody,
    }
  );

  if (!uploadRes.ok) {
    throw new Error(`Failed to upload application file to Google Drive (${uploadRes.status}).`);
  }

  const uploaded = (await uploadRes.json()) as {
    id: string;
    webViewLink?: string;
  };

  return {
    fileId: uploaded.id,
    fileUrl: uploaded.webViewLink || `https://drive.google.com/file/d/${uploaded.id}/view`,
    folderUrl,
  };
}
