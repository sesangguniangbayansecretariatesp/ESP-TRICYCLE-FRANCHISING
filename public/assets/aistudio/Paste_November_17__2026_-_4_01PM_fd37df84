export default function TricyclePortal({
  role,
  user,
  accessToken,
  authReady,
  isLoggingInGoogle,
  onGoogleSignIn,
  onGoogleLogout,
  onExit,
}: TricyclePortalProps) {
  const [activeTab, setActiveTab] = useState<'apply' | 'status' | 'dashboard'>(
    role === 'staff' ? 'dashboard' : 'apply'
  );
  const [formData, setFormData] = useState<ApplicationFormData>(INITIAL_FORM);
  const [banner, setBanner] = useState<BannerMessage | null>(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [lastSubmitted, setLastSubmitted] = useState<{
    record: ApplicationRecord;
    driveUrl?: string;
    driveFolderUrl?: string;
    drivePending?: boolean;
  } | null>(null);

  // Status Lookup State
  const [lookupRef, setLookupRef] = useState('');
  const [statusResult, setStatusResult] = useState<ApplicationRecord | null>(null);
  const [isLookingUp, setIsLookingUp] = useState(false);
  const [myApps, setMyApps] = useState<ApplicationRecord[]>([]);

  // Staff Dashboard State
  const [applications, setApplications] = useState<ApplicationRecord[]>([]);
  const [isLoadingDashboard, setIsLoadingDashboard] = useState(false);
  const [dashboardError, setDashboardError] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState<'all' | ApplicationStatus>('all');
  const [selectedApp, setSelectedApp] = useState<ApplicationRecord | null>(null);
  const [legislatorName, setLegislatorName] = useState('');
  const [legislatorRemarks, setLegislatorRemarks] = useState('');
  const [isUpdatingDecision, setIsUpdatingDecision] = useState(false);

  const isUserAdmin = isAuthorizedAdminEmail(user?.email);

  // Load user's own applications for quick reference in Status tab
  useEffect(() => {
    if (!authReady) return;
    if (!user) {
      setMyApps(getLocalApps());
      return;
    }

    const loadMyApps = async () => {
      try {
        const q = query(collection(db, 'applications'), where('userId', '==', user.uid));
        const snap = await getDocs(q);
        const cloudApps = snap.docs.map((d) => ({
          ...(d.data() as Omit<ApplicationRecord, 'id'>),
          id: d.id,
        }));
        setMyApps(cloudApps);
      } catch {
        setMyApps(getLocalApps());
      }
    };

    loadMyApps();
  }, [authReady, user, lastSubmitted]);

  // Real-time Firestore listener for Legislator / Staff Dashboard
  useEffect(() => {
    if (activeTab !== 'dashboard' || role !== 'staff') return;
    if (!authReady) return;

    if (!user) {
      setApplications(getLocalApps());
      setDashboardError(
        'Sign in with Google using an authorized Sangguniang Bayan account to sync cloud applications.'
      );
      return;
    }

    if (!isUserAdmin) {
      setApplications(getLocalApps());
      setDashboardError(
        `Signed in as ${user.email}. Cloud dashboard sync requires an authorized legislator/staff Google account (renieestrella90@gmail.com or sangguniangbayan01@gmail.com). Showing local session records only.`
      );
      return;
    }

    setIsLoadingDashboard(true);
    setDashboardError(null);

    const unsubscribe = onSnapshot(
      collection(db, 'applications'),
      (snapshot) => {
        const apps = snapshot.docs.map((d) => ({
          ...(d.data() as Omit<ApplicationRecord, 'id'>),
          id: d.id,
        }));
        apps.sort((a, b) => {
          const aTime =
            typeof a.submittedAt === 'object' &&
            a.submittedAt !== null &&
            'toMillis' in a.submittedAt
              ? (a.submittedAt as { toMillis: () => number }).toMillis()
              : 0;
          const bTime =
            typeof b.submittedAt === 'object' &&
            b.submittedAt !== null &&
            'toMillis' in b.submittedAt
              ? (b.submittedAt as { toMillis: () => number }).toMillis()
              : 0;
          return bTime - aTime;
        });
        setApplications(apps);
        setSelectedApp((prev) => (prev ? apps.find((a) => a.id === prev.id) || prev : null));
        setIsLoadingDashboard(false);
      },
      (error) => {
        setIsLoadingDashboard(false);
        setDashboardError('Unable to load cloud applications. Check permissions or network connection.');
        try {
          handleFirestoreError(error, OperationType.LIST, 'applications');
        } catch {
          // Error already logged in structured format by handleFirestoreError
        }
      }
    );

    return () => unsubscribe();
  }, [activeTab, role, authReady, user, isUserAdmin]);

  const handleCheckboxChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, checked } = e.target;
    setFormData((prev) => ({ ...prev, [name]: checked }));
  };

  const handleAttachmentChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, checked } = e.target;
    setFormData((prev) => ({
      ...prev,
      attachments: { ...prev.attachments, [name]: checked },
    }));
  };

  const handleUploadSavedToDrive = async (record: ApplicationRecord) => {
    try {
      let token = accessToken || getAccessToken();
      if (!token) {
        await onGoogleSignIn();
        token = getAccessToken();
      }
      if (!token) {
        setBanner({
          type: 'warning',
          text: 'Google Drive authorization was not granted. Please sign in and allow Google Drive access.',
        });
        return;
      }

      const driveRes = await saveApplicationToDrive(
        token,
        record.refNo,
        record,
        record.aiResult.summary
      );

      if (user && record.id && !record.id.startsWith('local-')) {
        try {
          await updateDoc(doc(db, 'applications', record.id), {
            driveFileId: driveRes.fileId.slice(0, 128),
            driveFolderUrl: driveRes.folderUrl.slice(0, 300),
            updatedAt: serverTimestamp(),
          });
        } catch (err) {
          handleFirestoreError(err, OperationType.UPDATE, `applications/${record.id}`);
        }
      }

      setLastSubmitted((prev) =>
        prev
          ? {
              ...prev,
              driveUrl: driveRes.fileUrl,
              driveFolderUrl: driveRes.folderUrl,
              drivePending: false,
            }
          : null
      );
      setBanner({
        type: 'success',
        text: `Application ${record.refNo} saved to Google Drive folder "franchising".`,
      });
    } catch (error) {
      const msg = error instanceof Error ? error.message : 'Google Drive upload failed.';
      setBanner({ type: 'error', text: msg });
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setBanner(null);

    if (!user) {
      setBanner({
        type: 'error',
        text: 'Please sign in with Google above before submitting your application so it can be synced securely.',
      });
      return;
    }

    if (
      !formData.applicantName.trim() ||
      !formData.contactNumber.trim() ||
      !formData.applicantAddress.trim() ||
      !formData.vehiclePlate.trim() ||
      !formData.licenseNumber.trim() ||
      !formData.licenseExpiry.trim() ||
      !formData.todaRoute.trim()
    ) {
      setBanner({
        type: 'error',
        text: 'Please complete all required fields (Name, Contact, Address, Plate No., Driver License, Expiry, and TODA Route).',
      });
      return;
    }

    setIsSubmitting(true);
    try {
      const refNo = generateRefNo();
      const sanitizedForm: ApplicationFormData = {
        applicationType: formData.applicationType,
        applicantName: formData.applicantName.trim().slice(0, 150),
        contactNumber: formData.contactNumber.trim().slice(0, 40),
        applicantAddress: formData.applicantAddress.trim().slice(0, 250),
        ctcNumber: formData.ctcNumber.trim().slice(0, 60),
        citizenshipAttested: formData.citizenshipAttested,
        bodyNumber: formData.bodyNumber.trim().slice(0, 50),
        engineNumber: formData.engineNumber.trim().slice(0, 60),
        vehiclePlate: formData.vehiclePlate.trim().toUpperCase().slice(0, 40),
        ltoCrNumber: formData.ltoCrNumber.trim().slice(0, 60),
        ltoOrNumber: formData.ltoOrNumber.trim().slice(0, 60),
        licenseNumber: formData.licenseNumber.trim().slice(0, 60),
        licenseExpiry: formData.licenseExpiry.trim().slice(0, 20),
        todaName: formData.todaName.trim().slice(0, 120),
        todaRoute: formData.todaRoute.trim().slice(0, 160),
        attachments: { ...formData.attachments },
      };

      const aiResult = classifyApplication(sanitizedForm);

      let docId = `local-${Date.now()}`;
      try {
        const docRef = await addDoc(collection(db, 'applications'), {
          ...sanitizedForm,
          userId: user.uid,
          refNo,
          aiResult: {
            decision: aiResult.decision,
            summary: aiResult.summary.slice(0, 300),
            reasons: aiResult.reasons.slice(0, 15).map((r) => r.slice(0, 300)),
          },
          status: 'awaiting_confirmation',
          submittedAt: serverTimestamp(),
        });
        docId = docRef.id;
      } catch (firestoreErr) {
        handleFirestoreError(firestoreErr, OperationType.CREATE, 'applications');
      }

      const createdRecord: ApplicationRecord = {
        ...sanitizedForm,
        id: docId,
        refNo,
        userId: user.uid,
        aiResult,
        status: 'awaiting_confirmation',
        submittedAt: new Date().toISOString(),
      };

      // Save local backup for fast lookup continuity
      const existingLocal = getLocalApps();
      saveLocalApps([createdRecord, ...existingLocal]);

      // Attempt Google Drive upload to 'franchising' folder if access token is available
      let driveUrl: string | undefined;
      let driveFolderUrl: string | undefined;
      let drivePending = false;

      if (accessToken) {
        try {
          const driveResult = await saveApplicationToDrive(
            accessToken,
            refNo,
            sanitizedForm,
            aiResult.summary
          );
          driveUrl = driveResult.fileUrl;
          driveFolderUrl = driveResult.folderUrl;

          try {
            await updateDoc(doc(db, 'applications', docId), {
              driveFileId: driveResult.fileId.slice(0, 128),
              driveFolderUrl: driveResult.folderUrl.slice(0, 300),
              updatedAt: serverTimestamp(),
            });
          } catch {
            // Non-fatal metadata update failure
          }
        } catch (driveErr) {
          drivePending = true;
          setBanner({
            type: 'warning',
            text: `Application ${refNo} saved to portal database, but Google Drive upload could not complete: ${
              driveErr instanceof Error ? driveErr.message : 'Drive error'
            }`,
          });
        }
      } else {
        drivePending = true;
      }

      setLastSubmitted({
        record: createdRecord,
        driveUrl,
        driveFolderUrl,
        drivePending,
      });
      setLookupRef(refNo);

      if (!drivePending) {
        setBanner({
          type: 'success',
          text: `Application submitted and backed up to Google Drive ("franchising" folder). Reference No: ${refNo}`,
        });
      } else if (!accessToken) {
        setBanner({
          type: 'success',
          text: `Application submitted to the Sangguniang Bayan queue! Reference No: ${refNo}. You can also back up a copy to your Google Drive "franchising" folder below.`,
        });
      }

      setFormData(INITIAL_FORM);
    } catch (error) {
      setBanner({
        type: 'error',
        text: formatFriendlyError(
          error,
          'Failed to submit application. Please verify your connection and sign-in.'
        ),
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleLookup = async (targetRef?: string) => {
    const queryRef = (targetRef ?? lookupRef).trim().toUpperCase();
    if (!queryRef) {
      setBanner({ type: 'error', text: 'Enter a reference number to look up.' });
      return;
    }

    setBanner(null);
    setIsLookingUp(true);
    try {
      let found: ApplicationRecord | null = null;

      if (user) {
        try {
          if (isUserAdmin) {
            const q = query(collection(db, 'applications'), where('refNo', '==', queryRef));
            const snap = await getDocs(q);
            if (!snap.empty) {
              const first = snap.docs[0];
              found = { ...(first.data() as Omit<ApplicationRecord, 'id'>), id: first.id };
            }
          } else {
            const q = query(collection(db, 'applications'), where('userId', '==', user.uid));
            const snap = await getDocs(q);
            const match = snap.docs.find(
              (d) => String(d.data().refNo || '').toUpperCase() === queryRef
            );
            if (match) {
              found = { ...(match.data() as Omit<ApplicationRecord, 'id'>), id: match.id };
            }
          }
        } catch (err) {
          handleFirestoreError(err, OperationType.LIST, 'applications');
        }
      }

      if (!found) {
        const localMatch = getLocalApps().find(
          (a) => String(a.refNo || '').toUpperCase() === queryRef
        );
        if (localMatch) found = localMatch;
      }

      if (found) {
        setStatusResult(found);
      } else {
        setStatusResult(null);
        setBanner({
          type: 'warning',
          text: `No application found for reference "${queryRef}". Make sure you are signed in with the Google account used during submission.`,
        });
      }
    } catch (error) {
      setStatusResult(null);
      setBanner({
        type: 'error',
        text: formatFriendlyError(
          error,
          'Unable to complete lookup. Please verify your sign-in status.'
        ),
      });
    } finally {
      setIsLookingUp(false);
    }
  };

  const handleLegislatorDecision = async (newStatus: ApplicationStatus) => {
    if (!selectedApp) return;
    setBanner(null);

    if (!legislatorName.trim()) {
      setBanner({
        type: 'error',
        text: 'Please enter the confirming Legislator / Sangguniang Bayan Member name.',
      });
      return;
    }

    if (!user || !isUserAdmin) {
      setBanner({
        type: 'error',
        text: 'Cloud status updates require signing in with an authorized Sangguniang Bayan Google account.',
      });
      return;
    }

    setIsUpdatingDecision(true);
    try {
      const cleanName = legislatorName.trim().slice(0, 150);
      const cleanRemarks = legislatorRemarks.trim().slice(0, 500);

      try {
        await updateDoc(doc(db, 'applications', selectedApp.id), {
          status: newStatus,
          legislatorName: cleanName,
          legislatorRemarks: cleanRemarks,
          legislatorActionAt: serverTimestamp(),
          updatedAt: serverTimestamp(),
        });
      } catch (err) {
        handleFirestoreError(err, OperationType.UPDATE, `applications/${selectedApp.id}`);
      }

      setBanner({
        type: 'success',
        text: `Application ${selectedApp.refNo} updated to "${formatStatusLabel(newStatus)}" by ${cleanName}.`,
      });
    } catch (error) {
      setBanner({
        type: 'error',
        text: formatFriendlyError(error, 'Failed to update application decision.'),
      });
    } finally {
      setIsUpdatingDecision(false);
    }
  };

  const filteredApplications = useMemo(() => {
    const q = searchTerm.trim().toLowerCase();
    return applications.filter((app) => {
      if (statusFilter !== 'all' && app.status !== statusFilter) return false;
      if (!q) return true;
      return (
        app.refNo.toLowerCase().includes(q) ||
        app.applicantName.toLowerCase().includes(q) ||
        app.vehiclePlate.toLowerCase().includes(q) ||
        (app.todaRoute || '').toLowerCase().includes(q)
      );
    });
  }, [applications, searchTerm, statusFilter]);

  const stats = useMemo(
    () => ({
      total: applications.length,
      awaiting: applications.filter((a) => a.status === 'awaiting_confirmation').length,
      approved: applications.filter((a) => a.status === 'confirmed_approved').length,
      denied: applications.filter((a) => a.status === 'confirmed_denied').length,
    }),
    [applications]
  );

  return (
    <div className="min-h-screen bg-[#F8F9F7]">
      <div className="masthead">
        <div className="masthead-inner">
          <div className="seal-mark">
            LGU
            <br />
            ESP
          </div>
          <div className="flex-1 min-w-0">
            <h1>Municipality of Sofronio Española Tricycle Franchise Portal</h1>
            <div className="sub">
              Implements <b>Ordinance No. 2018-836</b>, the Tricycle Management Code of Sofronio
              Española, Palawan. Automated checks are for{' '}
              <b>recommendation only—all decisions require legislator confirmation.</b>
            </div>
          </div>
          <div className="masthead-actions">
            {user ? (
              <div className="flex items-center gap-2 text-xs text-[#E0E9E4] bg-white/10 px-3 py-1.5 rounded-[3px]">
                <span className="truncate max-w-[180px]">{user.email}</span>
                {!accessToken && (
                  <button
                    type="button"
                    onClick={onGoogleSignIn}
                    className="underline text-[#e2b00a] cursor-pointer font-semibold"
                    disabled={isLoggingInGoogle}
                  >
                    Authorize Drive
                  </button>
                )}
              </div>
            ) : (
              <GoogleSignInButton
                onClick={onGoogleSignIn}
                disabled={isLoggingInGoogle}
                label={isLoggingInGoogle ? 'Signing in…' : 'Sign in with Google'}
              />
            )}

            <button
              type="button"
              onClick={async () => {
                if (role === 'staff' && user) {
                  await onGoogleLogout();
                }
                onExit();
              }}
              className="btn outline sm"
            >
              {role === 'staff' ? 'Logout' : 'Back to Homepage'}
            </button>
          </div>
        </div>

        <div className="tabs">
          <button
            type="button"
            className={`tab-btn ${activeTab === 'apply' ? 'active' : ''}`}
            onClick={() => {
              setActiveTab('apply');
              setBanner(null);
            }}
          >
            Submit Application
          </button>
          <button
            type="button"
            className={`tab-btn ${activeTab === 'status' ? 'active' : ''}`}
            onClick={() => {
              setActiveTab('status');
              setBanner(null);
            }}
          >
            Check Status &amp; Permit
          </button>
          {role === 'staff' && (
            <button
              type="button"
              className={`tab-btn ${activeTab === 'dashboard' ? 'active' : ''}`}
              onClick={() => {
                setActiveTab('dashboard');
                setBanner(null);
              }}
            >
              Legislator / Staff Dashboard
            </button>
          )}
        </div>
      </div>

      <main>
        {banner && (
          <div className={`alert-banner ${banner.type} no-print`} role="alert">
            <span>{banner.text}</span>
            <button
              type="button"
              className="btn outline sm"
              onClick={() => setBanner(null)}
            >
              Dismiss
            </button>
          </div>
        )}

        {/* TAB 1: SUBMIT APPLICATION */}
        {activeTab === 'apply' && (
          <div className="view active">
            {lastSubmitted && (
              <div className="panel" style={{ borderColor: '#0e7c53' }}>
                <div className="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <div className="panel-title">Application Submitted</div>
                    <p className="panel-note m-0">
                      Reference Number:{' '}
                      <strong className="tabular text-[#0e7c53] text-base">
                        {lastSubmitted.record.refNo}
                      </strong>
                    </p>
                  </div>
                  <span className={getRecommendationBadgeClass(lastSubmitted.record.aiResult.decision)}>
                    Automated Check: {lastSubmitted.record.aiResult.decision.toUpperCase()}
                  </span>
                </div>

                <p className="text-sm text-[#1A211D] mt-3 mb-2">
                  {lastSubmitted.record.aiResult.summary}
                </p>

                <div className="flex flex-wrap gap-2 mt-4">
                  <button
                    type="button"
                    className="btn sm"
                    onClick={() => {
                      setActiveTab('status');
                      setLookupRef(lastSubmitted.record.refNo);
                      handleLookup(lastSubmitted.record.refNo);
                    }}
                  >
                    View Status &amp; Receipt
                  </button>

                  {lastSubmitted.driveUrl ? (
                    <a
                      href={lastSubmitted.driveUrl}
                      target="_blank"
                      rel="noreferrer"
                      className="btn outline sm"
                    >
                      Open Copy in Google Drive
                    </a>
                  ) : (
                    <button
                      type="button"
                      className="btn gold sm"
                      onClick={() => handleUploadSavedToDrive(lastSubmitted.record)}
                    >
                      {accessToken
                        ? 'Upload Copy to Drive ("franchising")'
                        : 'Authorize Google Drive & Save Copy'}
                    </button>
                  )}
                </div>
              </div>
            )}

            <div className="panel">
              <div className="panel-title">New Franchise / Renewal Application</div>
              <div className="panel-note">
                Fields marked with a <span className="req-tag">REQUIRED</span> tag are required by
                Ordinance No. 2018-836.
              </div>

              {!user && (
                <div className="alert-banner warning">
                  <div>
                    <strong>Google Sign-In required:</strong> Sign in with Google to save your
                    application to the municipal database and Google Drive &ldquo;franchising&rdquo; folder.
                  </div>
                  <GoogleSignInButton
                    onClick={onGoogleSignIn}
                    disabled={isLoggingInGoogle}
                    label="Sign in with Google"
                  />
                </div>
              )}

              <div className="notice-banner">
                <b>Important:</b> This portal performs completeness checks only. It does not grant
                franchises. Final approval rests with the Sangguniang Bayan through the Tricycle
                Franchising Board (Sec. 7–8).
              </div>

              <form onSubmit={handleSubmit} className="flex flex-col gap-3">
                <div className="section-label">1 &middot; Application Type</div>
                <div className="field">
                  <label htmlFor="app-type">
                    Application Type <span className="req-tag">REQUIRED</span>
                  </label>
                  <select
                    id="app-type"
                    className="w-full md:w-1/2"
                    value={formData.applicationType}
                    onChange={(e) =>
                      setFormData({
                        ...formData,
                        applicationType: e.target.value as 'new' | 'renewal',
                      })
                    }
                  >
                    <option value="new">New Application</option>
                    <option value="renewal">Renewal</option>
                  </select>
                </div>

                <div className="section-label">2 &middot; Personal Information</div>
                <div className="field">
                  <label htmlFor="applicant-name">
                    Full Name <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="applicant-name"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.applicantName}
                    onChange={(e) => setFormData({ ...formData, applicantName: e.target.value })}
                    required
                  />
                </div>
                <div className="field">
                  <label htmlFor="contact-no">
                    Contact Number <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="contact-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.contactNumber}
                    onChange={(e) => setFormData({ ...formData, contactNumber: e.target.value })}
                    required
                  />
                </div>
                <div className="field">
                  <label htmlFor="applicant-address">
                    Complete Address <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="applicant-address"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.applicantAddress}
                    onChange={(e) =>
                      setFormData({ ...formData, applicantAddress: e.target.value })
                    }
                    required
                  />
                </div>
                <div className="field">
                  <label htmlFor="ctc-no">
                    CTC / Cedula No. <span className="opt-tag">OPTIONAL</span>
                  </label>
                  <input
                    id="ctc-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.ctcNumber}
                    onChange={(e) => setFormData({ ...formData, ctcNumber: e.target.value })}
                  />
                </div>
                <label className="check-row required w-full md:w-1/2">
                  <input
                    type="checkbox"
                    name="citizenshipAttested"
                    checked={formData.citizenshipAttested}
                    onChange={handleCheckboxChange}
                  />
                  <span className="ctext">
                    I attest I am a Filipino citizen <span className="cite">(Sec. 24.1)</span>
                    <span className="req-tag">REQUIRED</span>
                  </span>
                </label>

                <div className="section-label">3 &middot; Motorcycle / Tricycle Unit</div>
                <div className="field">
                  <label htmlFor="body-no">
                    Body Number <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="body-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.bodyNumber}
                    onChange={(e) => setFormData({ ...formData, bodyNumber: e.target.value })}
                  />
                </div>
                <div className="field">
                  <label htmlFor="engine-no">
                    Engine Number <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="engine-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.engineNumber}
                    onChange={(e) => setFormData({ ...formData, engineNumber: e.target.value })}
                  />
                </div>
                <div className="field">
                  <label htmlFor="plate-no">
                    Plate Number <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="plate-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.vehiclePlate}
                    onChange={(e) => setFormData({ ...formData, vehiclePlate: e.target.value })}
                    required
                  />
                </div>
                <div className="field">
                  <label htmlFor="cr-no">
                    LTO CR No. <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="cr-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.ltoCrNumber}
                    onChange={(e) => setFormData({ ...formData, ltoCrNumber: e.target.value })}
                  />
                </div>
                <div className="field">
                  <label htmlFor="or-no">
                    LTO OR No. <span className="opt-tag">OPTIONAL</span>
                  </label>
                  <input
                    id="or-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.ltoOrNumber}
                    onChange={(e) => setFormData({ ...formData, ltoOrNumber: e.target.value })}
                  />
                </div>

                <div className="section-label">4 &middot; Driver&apos;s License</div>
                <div className="field">
                  <label htmlFor="license-no">
                    License Number <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="license-no"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.licenseNumber}
                    onChange={(e) => setFormData({ ...formData, licenseNumber: e.target.value })}
                    required
                  />
                </div>
                <div className="field">
                  <label htmlFor="license-expiry">
                    Validity / Expiry Date <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="license-expiry"
                    className="w-full md:w-1/2"
                    type="date"
                    value={formData.licenseExpiry}
                    onChange={(e) => setFormData({ ...formData, licenseExpiry: e.target.value })}
                    required
                  />
                </div>

                <div className="section-label">5 &middot; TODA &amp; Route</div>
                <div className="field">
                  <label htmlFor="toda-name">
                    TODA Name <span className="req-tag">REQUIRED</span>
                  </label>
                  <input
                    id="toda-name"
                    className="w-full md:w-1/2"
                    type="text"
                    value={formData.todaName}
                    onChange={(e) => setFormData({ ...formData, todaName: e.target.value })}
                  />
                </div>
                <div className="field">
                  <label htmlFor="toda-route">
                    Route / Zone <span className="req-tag">REQUIRED</span>
                  </label>
                  <select
                    id="toda-route"
                    className="w-full md:w-1/2"
                    value={formData.todaRoute}
                    onChange={(e) => setFormData({ ...formData, todaRoute: e.target.value })}
                    required
                  >
                    <option value="">Select Route…</option>
                    {TODA_ROUTES.map((route) => (
                      <option key={route} value={route}>
                        {route}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="section-label">6 &middot; Attachments Checklist</div>
                <div className="flex flex-col gap-2 w-full md:w-3/4">
                  <label className="check-row required">
                    <input
                      type="checkbox"
                      name="license"
                      checked={formData.attachments.license}
                      onChange={handleAttachmentChange}
                    />
                    <span className="ctext">
                      <span>Valid Professional Driver&apos;s License (LTO-issued)</span>
                      <span className="cite">(Sec. 39(3))</span>
                      <span className="req-tag">AUTO DENY IF MISSING</span>
                    </span>
                  </label>

                  <label className="check-row required">
                    <input
                      type="checkbox"
                      name="cr"
                      checked={formData.attachments.cr}
                      onChange={handleAttachmentChange}
                    />
                    <span className="ctext">
                      <span>LTO Certificate of Registration (CR) &amp; latest OR in applicant&apos;s name</span>
                      <span className="cite">(Sec. 24(6))</span>
                      <span className="req-tag">AUTO DENY IF MISSING</span>
                    </span>
                  </label>

                  {ATTACHMENT_LABELS.slice(2).map((item) => (
                    <label key={item.key} className="check-row">
                      <input
                        type="checkbox"
                        name={item.key}
                        checked={formData.attachments[item.key]}
                        onChange={handleAttachmentChange}
                      />
                      <span className="ctext">
                        <span>{item.label}</span>
                        <span className="opt-tag">SUPPORTING</span>
                      </span>
                    </label>
                  ))}
                </div>

                <div className="mt-4">
                  <button type="submit" className="btn" disabled={isSubmitting}>
                    {isSubmitting ? 'Submitting Application…' : 'Submit Application'}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        {/* TAB 2: CHECK STATUS & PERMIT */}
        {activeTab === 'status' && (
          <div className="view active">
            <div className="panel no-print">
              <div className="panel-title">Check Status &amp; Permit</div>
              <div className="panel-note">
                Enter the reference number given at submission to view the current status. An
                official permit summary renders here only after a legislator confirms approval.
              </div>

              <div className="flex flex-col md:flex-row gap-3 md:items-end">
                <div className="field flex-1">
                  <label htmlFor="lookup-ref-input">Reference Number</label>
                  <input
                    id="lookup-ref-input"
                    className="w-full md:w-1/2 tabular"
                    type="text"
                    value={lookupRef}
                    onChange={(e) => setLookupRef(e.target.value)}
                    placeholder="SOF-ESP-TRC-2026-0001"
                  />
                </div>
                <button
                  type="button"
                  className="btn"
                  disabled={isLookingUp}
                  onClick={() => handleLookup()}
                >
                  {isLookingUp ? 'Looking Up…' : 'Look Up'}
                </button>
              </div>

              {myApps.length > 0 && (
                <div className="mt-5 pt-4 border-t border-[#D8D9D6]">
                  <div className="text-xs font-semibold text-[#5B6660] mb-2">
                    Your Recent Submissions (click to load):
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {myApps.slice(0, 6).map((item) => (
                      <button
                        key={item.id || item.refNo}
                        type="button"
                        className="btn outline sm tabular"
                        onClick={() => {
                          setLookupRef(item.refNo);
                          handleLookup(item.refNo);
                        }}
                      >
                        {item.refNo} · {item.vehiclePlate}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {isLookingUp && (
              <div className="panel text-center text-sm text-[#5B6660]">
                Searching municipal records…
              </div>
            )}

            {!isLookingUp && statusResult && (
              <div className="panel">
                <div className="seal-wrap">
                  <StatusSeal status={statusResult.status} />
                  <div className="flex-1">
                    <div className="flex flex-wrap items-center gap-2 mb-1">
                      <span className="tabular font-bold text-[#0e7c53] text-lg">
                        {statusResult.refNo}
                      </span>
                      <span className={getStatusBadgeClass(statusResult.status)}>
                        {formatStatusLabel(statusResult.status)}
                      </span>
                    </div>
                    <div className="text-sm text-[#5B6660]">
                      Applicant: <strong className="text-[#1A211D]">{statusResult.applicantName}</strong> ·
                      Plate: <strong className="tabular text-[#1A211D]">{statusResult.vehiclePlate}</strong> ·
                      Submitted: {formatTimestamp(statusResult.submittedAt)}
                    </div>
                  </div>
                </div>

                {statusResult.aiResult && (
                  <div className="confirm-box">
                    <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <strong className="text-sm text-[#0e7c53]">
                        Automated Ordinance No. 2018-836 Pre-Check
                      </strong>
                      <span className={getRecommendationBadgeClass(statusResult.aiResult.decision)}>
                        Recommendation: {statusResult.aiResult.decision.toUpperCase()}
                      </span>
                    </div>
                    <p className="text-sm text-[#1A211D] mb-2">{statusResult.aiResult.summary}</p>
                    {statusResult.aiResult.reasons && statusResult.aiResult.reasons.length > 0 && (
                      <ul className="list-disc pl-5 text-xs text-[#5B6660] space-y-1">
                        {statusResult.aiResult.reasons.map((reason, idx) => (
                          <li key={idx}>{reason}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                )}

                {(statusResult.status === 'confirmed_denied' || statusResult.status === 'returned') && (
                  <div className="alert-banner error mt-4">
                    <div>
                      <strong>
                        {statusResult.status === 'confirmed_denied'
                          ? 'Notice of Action — Franchise Denied'
                          : 'Returned for Applicant Correction'}
                      </strong>
                      <div className="text-sm mt-1">
                        Reviewed by: <strong>{statusResult.legislatorName || 'Sangguniang Bayan'}</strong>
                      </div>
                      {statusResult.legislatorRemarks && (
                        <div className="text-sm mt-1">Remarks: {statusResult.legislatorRemarks}</div>
                      )}
                    </div>
                  </div>
                )}

                {statusResult.status === 'confirmed_approved' && (
                  <div className="permit">
                    <div className="permit-head">
                      <div className="text-xs uppercase tracking-widest text-[#5B6660]">
                        Republic of the Philippines · Province of Palawan
                      </div>
                      <h3>Municipality of Sofronio Española</h3>
                      <div className="text-sm font-semibold text-[#1A211D]">
                        Office of the Sangguniang Bayan · Tricycle Franchising Board
                      </div>
                      <div className="mt-2 inline-block px-3 py-1 bg-[#D6E9E0] text-[#0c6344] text-xs font-bold tracking-wider uppercase">
                        Official Motorized Tricycle Operator&apos;s Permit (MTOP) Summary
                      </div>
                    </div>

                    <div className="permit-grid">
                      <div>
                        <div className="detail-item-label">Franchise Reference No.</div>
                        <div className="detail-item-val tabular">{statusResult.refNo}</div>
                      </div>
                      <div>
